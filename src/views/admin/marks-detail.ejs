<%
  var s = data.submission;
  var clsLabel = formatClassLabel({ name: s.class_name, division: s.class_division });
%>
<div class="pagehead">
  <div>
    <div class="eyebrow"><%= s.year_name %> &middot; <%= termLabel(s.term) %></div>
    <h1><%= clsLabel %> — <%= s.subject_name %></h1>
    <p class="lede">
      Entered by <strong><%= s.teacher_name %></strong> on <%= fmtDateTime(s.submitted_at) %>.
    </p>
  </div>
  <div class="btn-row">
    <a class="btn btn-ghost" href="/admin/marks">All submissions</a>
    <a class="btn btn-primary" href="/admin/marks/<%= s.id %>/edit">Correct marks</a>
    <a class="btn btn-accent" href="/admin/marks/<%= s.id %>/excel">Excel</a>
    <a class="btn btn-ghost" href="/admin/marks/<%= s.id %>/pdf">PDF</a>
  </div>
</div>

<%- include('../partials/submission-meta') %>
<%- include('../partials/marks-readonly', { data: data }) %>

<div class="grid grid-top mt-6" style="grid-template-columns:minmax(300px,1fr) minmax(320px,1fr)">

  <div class="card">
    <h3>Release for re-entry</h3>
    <p class="muted text-sm" style="margin-top:var(--space-2)">
      Teachers cannot overwrite a submission. Releasing <strong>deletes these <%= data.students.length %> mark
      records</strong> and reopens <%= clsLabel %> — <%= s.subject_name %> — <%= termLabel(s.term) %> so a teacher
      can enter it again. The deleted values are preserved in the audit trail below.
    </p>
    <p class="hint">To fix one or two marks, use <strong>Correct marks</strong> instead — it keeps the record intact.</p>

    <form method="post" action="/admin/marks/<%= s.id %>/release" class="mt-4"
          onsubmit="return releaseConfirm(this)">
      <input type="hidden" name="confirm" value="">
      <button class="btn btn-danger" type="submit">Release submission</button>
    </form>
  </div>

  <div class="card">
    <h3>Audit trail</h3>
    <% if (!history.length) { %>
      <p class="muted text-sm" style="margin-top:var(--space-2)">Nothing recorded for this submission yet.</p>
    <% } else { %>
      <ul style="list-style:none;padding:0;margin:var(--space-2) 0 0;max-height:320px;overflow-y:auto">
        <% history.forEach(function (h) { %>
          <li style="padding:var(--space-3) 0;border-bottom:1px solid var(--hairline)">
            <div class="row-between">
              <strong class="text-sm"><%= h.action %></strong>
              <span class="text-xs faint"><%= fmtDateTime(h.created_at) %></span>
            </div>
            <div class="text-xs muted"><%= h.actor_name || h.actor_type %></div>
            <% if (h.action === 'marks.update' && h.details && h.details.changed && h.details.changed.length) { %>
              <ul class="text-xs" style="margin:var(--space-2) 0 0;padding-left:1.1rem;color:var(--ink-muted)">
                <% h.details.changed.slice(0, 8).forEach(function (ch) { %>
                  <li>
                    <strong><%= ch.student %></strong>:
                    <% if (ch.unit_test) { %>
                      unit test <%= ch.unit_test.from === null ? 'AB' : ch.unit_test.from %> &rarr;
                      <%= ch.unit_test.to === null ? 'AB' : ch.unit_test.to %><%= ch.secondary ? '; ' : '' %>
                    <% } %>
                    <% if (ch.secondary) { %>
                      <%= componentLabel(s.secondary_component).toLowerCase() %>
                      <%= ch.secondary.from === null ? 'AB' : ch.secondary.from %> &rarr;
                      <%= ch.secondary.to === null ? 'AB' : ch.secondary.to %>
                    <% } %>
                  </li>
                <% }) %>
                <% if (h.details.changed.length > 8) { %><li>…and <%= h.details.changed.length - 8 %> more</li><% } %>
              </ul>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

</div>

<script>
  function releaseConfirm(form) {
    var typed = prompt(
      'Releasing deletes the marks currently recorded for this class, subject and term\n' +
      'so that a teacher can enter them again.\n\n' +
      'Type RELEASE to confirm:'
    );
    if (typed === null) return false;
    form.querySelector('input[name="confirm"]').value = typed;
    return true;
  }
</script>
