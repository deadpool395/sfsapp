<div class="pagehead">
  <div>
    <div class="eyebrow">Staff portal</div>
    <h1>Welcome, <%= user.teacherName %></h1>
    <p class="lede">Choose a tool below. Marks you submit are recorded against your name.</p>
  </div>
  <% if (submissionCount) { %>
    <a class="btn btn-ghost" href="/teacher/marks/view">
      <%= submissionCount %> <%= submissionCount === 1 ? 'submission' : 'submissions' %> so far
    </a>
  <% } %>
</div>

<div class="grid grid-3">

  <a class="tile" href="<%= externalLinks.dropbox %>" target="_blank" rel="noopener noreferrer">
    <span class="tile-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <path d="M7 10l5 5 5-5M12 15V3"/>
      </svg>
    </span>
    <h3>SFS Dropbox</h3>
    <p>Shared file drop for circulars, question papers and staff documents.</p>
    <span class="tile-meta">
      Open
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7M9 7h8v8"/>
      </svg>
    </span>
  </a>

  <a class="tile" href="<%= externalLinks.markSubmission %>" target="_blank" rel="noopener noreferrer">
    <span class="tile-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 11l3 3L22 4"/>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
      </svg>
    </span>
    <h3>SFS Mark Submission System</h3>
    <p>The existing examination mark submission system.</p>
    <span class="tile-meta">
      Open
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7M9 7h8v8"/>
      </svg>
    </span>
  </a>

  <a class="tile is-accent" href="/teacher/marks">
    <span class="tile-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
      </svg>
    </span>
    <h3>Assignment &amp; Unit Test Marks</h3>
    <p>Enter unit test and assignment or practical marks for a class, subject and term.</p>
    <span class="tile-meta">
      Start entry
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"/>
      </svg>
    </span>
  </a>

</div>
