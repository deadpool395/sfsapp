<%
  var s = data.submission;
  var secLabel = componentLabel(s.secondary_component);
  var st8 = data.state;
  var cols = [
    { key: 'unit_test', label: 'Unit Test', st: st8.unit_test, prop: 'unitTest' },
    { key: 'secondary', label: secLabel,    st: st8.secondary, prop: 'secondary' }
  ];
%>
<div class="card card-flush">
  <div class="card-head">
    <div>
      <h3 style="margin:0">Marks</h3>
      <div class="text-xs muted">
        <% cols.forEach(function (c, i) { %>
          <%= i ? ' · ' : '' %><%= c.label %>
          <%= c.st.recorded ? 'out of ' + fmtMark(c.st.max) : 'not yet entered' %>
        <% }) %>
        &middot; AB = absent &middot; — = not yet entered
      </div>
    </div>
    <% if (typeof actions !== 'undefined') { %><div class="btn-row no-print"><%- actions %></div><% } %>
  </div>

  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th class="mid" style="width:3.5rem">Sl.</th>
          <th class="mid" style="width:4.5rem">Roll</th>
          <th style="width:8rem">Adm. No.</th>
          <th>Student Name</th>
          <% cols.forEach(function (c) { %>
            <th class="mid">
              <%= c.label %><br>
              <span class="text-xs" style="text-transform:none;letter-spacing:0">
                <%= c.st.recorded ? '/ ' + fmtMark(c.st.max) : 'pending' %>
              </span>
            </th>
          <% }) %>
          <th class="mid">Total<br><span class="text-xs" style="text-transform:none;letter-spacing:0">/ <%= fmtMark(data.totalMax) %></span></th>
          <th class="mid">%</th>
        </tr>
      </thead>
      <tbody>
        <% data.students.forEach(function (stu) { %>
          <tr<%= stu.absent ? ' style="color:var(--ink-faint)"' : '' %>>
            <td class="mid tnum"><%= stu.index %></td>
            <td class="mid tnum"><%= stu.rollNo || '—' %></td>
            <td class="tnum"><%= stu.admissionNo || '—' %></td>
            <td class="row-name"><%= stu.name %></td>
            <% cols.forEach(function (c) { %>
              <td class="mid tnum">
                <% if (!c.st.recorded) { %>—
                <% } else { %><%= stu[c.prop] === null ? 'AB' : fmtMark(stu[c.prop]) %><% } %>
              </td>
            <% }) %>
            <td class="mid tnum"><strong><%= stu.total === null ? '—' : fmtMark(stu.total) %></strong></td>
            <td class="mid tnum"><%= stu.percent === null ? '—' : stu.percent.toFixed(1) + '%' %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4">Total — <%= data.totals.counted %> assessed, <%= data.totals.absent %> absent</td>
          <% cols.forEach(function (c) { %>
            <td class="mid tnum">
              <% if (!c.st.recorded) { %>—
              <% } else { %><%= data.totals[c.prop] === null ? '—' : fmtMark(data.totals[c.prop]) %><% } %>
            </td>
          <% }) %>
          <td class="mid tnum"><%= data.totals.total === null ? '—' : fmtMark(data.totals.total) %></td>
          <td class="mid tnum"><%= data.totals.averagePercent === null ? '—' : data.totals.averagePercent.toFixed(1) + '%' %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
