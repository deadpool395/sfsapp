{
  "name": "sfsapp",
  "version": "1.0.0",
  "private": true,
  "description": "SFS School Portal — admin management, student Excel import, and Assignment/Unit Test mark submission",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:create": "node src/db/create.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/create.js && node src/db/migrate.js && node src/db/seed.js",
    "inspect:xlsx": "node scripts/inspect-xlsx.js",
    "db:backup": "node scripts/backup-db.js",
    "logo:mark": "node scripts/make-logo-mark.js",
    "report:preview": "node scripts/preview-report.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.1",
    "multer": "^2.0.1",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "puppeteer-core": "^25.13.0"
  }
}
