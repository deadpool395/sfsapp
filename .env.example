# Copy to .env and adjust.
#
# NOTE: PostgreSQL 13 occupies the default port 5432 on this machine.
# PostgreSQL 18 listens on 5433 — that is the port this app must use.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/sfsapp

# Remote backup target, e.g. a Render Postgres external URL.
# Used only by `npm run db:backup`; leave blank to disable backups.
BACKUP_DATABASE_URL=

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Shown in report headers and the page masthead.
SCHOOL_NAME=St. Francis School

# Seed credentials (used only by `npm run db:seed`). Change them in Settings afterwards.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_TEACHER_USERNAME=teacher
SEED_TEACHER_PASSWORD=sfs2026
